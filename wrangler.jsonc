// Cloudflare deploys this with `npx wrangler deploy`. There's no build step.
// worker/index.js runs first on every request: it gates the board and its data behind the
// sign-up and serves everything else straight from the public folder.
{
  "name": "spawnbook",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Sign-ups and sign-in sessions, stored in SQLite inside a Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "observability": { "enabled": true },
  // Keep settings added in the Cloudflare dashboard (like ADMIN_KEY) when GitHub redeploys the site.
  "keep_vars": true
}
